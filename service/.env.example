DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/test_demo?charset=utf8mb4

# 如果你本地使用 PostgreSQL，可改成下面这种格式：
# DATABASE_URL=postgresql+pg8000://postgres:password@127.0.0.1:5432/test_demo

# 如果不提供 DATABASE_URL，服务会自动回退到本地 SQLite：
# DATABASE_URL=sqlite:///app.db
# 本地 Docker MinIO 配置示例：
# docker run -p 9000:9000 -p 9001:9001 --name local-minio \
#   -e MINIO_ROOT_USER=minioadmin \
#   -e MINIO_ROOT_PASSWORD=minioadmin \
#   quay.io/minio/minio server /data --console-address ":9001"
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=study-python
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
